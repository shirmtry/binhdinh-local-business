<%- include('partials/header') %>

<h1>Danh sách quán đặc sản Quy Nhơn</h1>
<p class="mock-note"><%= mockLabel %> — tên quán hư cấu, địa chỉ dùng đường thật ở Quy Nhơn; giá &amp; đánh giá là mô phỏng.</p>

<form class="filter card" method="get" action="/danh-sach">
  <div class="filter-row">
    <label>Tìm kiếm
      <input type="search" name="q" value="<%= q %>" placeholder="Tên quán, món, đường…">
    </label>
    <label>Món đặc sản
      <select name="mon">
        <option value="">— Tất cả món —</option>
        <% mons.forEach(function(m){ %>
          <option value="<%= m %>" <%= mon === m ? 'selected' : '' %>><%= m %></option>
        <% }) %>
      </select>
    </label>
    <label>Khu vực
      <select name="khu">
        <option value="">— Tất cả khu vực —</option>
        <% khuVucs.forEach(function(k){ %>
          <option value="<%= k %>" <%= khuVuc === k ? 'selected' : '' %>><%= k %></option>
        <% }) %>
      </select>
    </label>
    <label>Sắp xếp
      <select name="sapxep">
        <option value="danh-gia" <%= sapXep === 'danh-gia' ? 'selected' : '' %>>Đánh giá cao nhất</option>
        <option value="gia-tang" <%= sapXep === 'gia-tang' ? 'selected' : '' %>>Giá thấp → cao</option>
        <option value="gia-giam" <%= sapXep === 'gia-giam' ? 'selected' : '' %>>Giá cao → thấp</option>
      </select>
    </label>
  </div>
  <div class="filter-actions">
    <button class="btn" type="submit">🔍 Lọc kết quả</button>
    <a class="btn btn-ghost" href="/danh-sach">Xóa bộ lọc</a>
  </div>
</form>

<p class="result-count">Tìm thấy <strong><%= found %></strong> / <%= total %> quán
  <% if (mon) { %>· món: <strong><%= mon %></strong><% } %>
  <% if (q) { %>· từ khóa: "<strong><%= q %></strong>"<% } %>
</p>

<% if (found === 0) { %>
  <div class="card empty">
    <p>Không tìm thấy quán phù hợp. Thử bỏ bớt bộ lọc hoặc từ khóa khác nhé!</p>
    <a class="btn" href="/danh-sach">Xem tất cả quán</a>
  </div>
<% } %>

<div class="grid">
  <% quans.forEach(function(qq){ %>
    <article class="card shop">
      <span class="badge"><%= qq.mon %></span>
      <% if (qq.khuVuc === 'Chợ đêm') { %><span class="badge badge-night">🏮 Chợ đêm</span><% } %>
      <h3><a href="/quan/<%= qq.id %>"><%= qq.ten %></a></h3>
      <p class="addr">📍 <%= qq.diaChi %></p>
      <p class="price">💰 <%= qq.giaTu %>–<%= qq.giaDen %>k đ / người</p>
      <p class="stars">⭐ <%= qq.sao.toFixed(1) %> / 5 · <%= qq.luotDanhGia %> lượt (mock)</p>
      <p class="hours">🕒 <%= qq.gioMoCua %> · <%= qq.khuVuc %></p>
      <blockquote class="review-mini">“<%= qq.danhGiaMock[0].noiDung %>” — <%= qq.danhGiaMock[0].ten %> (đánh giá mô phỏng)</blockquote>
      <a class="btn btn-small" href="/quan/<%= qq.id %>">Chi tiết &amp; đánh giá →</a>
    </article>
  <% }) %>
</div>

<%- include('partials/footer') %>